<!DOCTYPE html>
<html html-attrs>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <vc:page-head />

    <phoria-island-styles />
    <phoria-island-preload />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <main role="main" id="root">
        @RenderBody()
    </main>

    <phoria-island-scripts />

    @* TODO: Create app View Component to set this up *@
    <script src="https://app.storyblok.com/f/storyblok-v2-latest.js"></script>
    <script>
        const storyblokBridge = new StoryblokBridge()

        storyblokBridge.on(['change', 'published'], () => {
            location.reload(true)
        })
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
